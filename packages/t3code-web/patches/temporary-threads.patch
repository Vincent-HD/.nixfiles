+  if (fromKey === toKey || !state.temporaryThreadKeys.includes(fromKey)) return state;
+  return {
+    ...state,
+    temporaryThreadKeys: [
+      ...state.temporaryThreadKeys.filter(
+        (threadKey) => threadKey !== fromKey && threadKey !== toKey,
+      ),
+      toKey,
+    ],
+  };
+}
