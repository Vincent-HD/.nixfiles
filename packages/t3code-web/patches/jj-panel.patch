+    const repositoryPath = yield* fs
+      .realPath(repoLocation)
+      .pipe(Effect.mapError(() => error("command-failed")));
+    const wcInfo = yield* fs
+      .stat(path.join(workspaceRoot, ".jj", "working_copy"))
+      .pipe(Effect.mapError(() => error("command-failed")));
