+                  · <span className="font-mono">{id}</span>
+                </p>
+              ))}
+            </div>
+          )}
+          {preview.kind === "absorb" && (
+            <p className="text-xs">
+              Destination: mutable, conflict-free ancestors of{" "}
+              <span className="font-mono">{preview.source.changeId.slice(0, 8)}</span>, selected by
