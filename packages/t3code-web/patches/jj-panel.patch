+          preview={preview}
+          visible={props.visible}
+          busy={mutating}
+          revertingPanelAction={Boolean(revertReceipt)}
+          blocked={blocked || !canAct || Boolean(revertReceipt && !canRevert)}
+          stale={previewStale || Boolean(revertReceipt && !undoAvailable)}
