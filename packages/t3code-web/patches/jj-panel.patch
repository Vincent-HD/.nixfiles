+          error={error}
+          onCancel={() => {
+            setPreview(null);
+            setRevertReceipt(null);
+          }}
+          onConfirm={(action) => {
+            if (
+              blocked ||
+              !canAct ||
+              previewStale ||
+              dirtyWorkingCopy ||
+              (revertReceipt && (!canRevert || !undoAvailable))
+            )
+              return;
+            const input = {
+              cwd: preview.cwd,
+              workspaceIdentity: preview.panel.workspaceIdentity,
