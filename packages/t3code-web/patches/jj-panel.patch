+      cwd: input.panel.cwd,
+      args: [
+        "--at-operation",
+        input.panel.operationId,
+        "log",
+        "--no-graph",
+        "-r",
+        `bookmarks(exact:${quote(input.bookmark)})`,
+        "-T",
+        'json(commit_id) ++ "\\n"',
+      ],
+    });
