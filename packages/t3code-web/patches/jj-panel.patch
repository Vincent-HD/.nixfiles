+    }
+    const locator = yield* Effect.try({
+      try: () => {
+        const scp = /^[^@\s]+@[^:\s]+:(.+)$/.exec(remoteUrl);
+        return {
+          host: new URL(context.provider.baseUrl).host,
+          repository: (scp?.[1] ?? new URL(remoteUrl).pathname)
+            .replace(/^\/+|\/+$/g, "")
+            .replace(/\.git$/, ""),
