+            const ordered = [...records].sort(
+              (left, right) =>
+                Number(right.state === "open") - Number(left.state === "open") ||
+                right.number - left.number,
+            );
+            const record = ordered[0];
+            if (!record) return;
+            const ref = reference({ request: input, destination: resolved.destination, record });
