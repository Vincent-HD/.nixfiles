diff --git a/apps/web/src/components/chat/composer-usage.logic.test.ts b/apps/web/src/components/chat/composer-usage.logic.test.ts
new file mode 100644
index 00000000..afc5a81a
--- /dev/null
+++ b/apps/web/src/components/chat/composer-usage.logic.test.ts
@@ -0,0 +1,248 @@
+import { describe, expect, it } from "vite-plus/test";
+import * as DateTime from "effect/DateTime";
+import {
+  composerQuotaSummary,
+  compactTokenCount,
+  completedTurnDuration,
+  lastResponseUsage,
+  selectComposerUsageAccounts,
+  sessionUsage,
+  toolUsageDuration,
+  formatUsageDuration,
+  type CompletedUsageTurn,
+} from "./composer-usage.logic";
+import { ProviderDriverKind, ProviderInstanceId, type UsageLimitsReport } from "@t3tools/contracts";
+
+describe("compactTokenCount", () => {
+  it.each([
+    [0, "0"],
+    [999, "999"],
+    [1000, "1K"],
+    [134351, "134K"],
+    [5173243, "5.2M"],
+    [1300000000, "1.3B"],
+    [999999, "1M"],
+    [1000000000000, "1T"],
+    [null, "—"],
+    [undefined, "—"],
+  ])("formats %s as %s", (value, expected) => {
+    expect(compactTokenCount(value)).toBe(expected);
+  });
+});
+
+describe("composer quota selection", () => {
+  const selectedInstanceId = ProviderInstanceId.make("codex-personal");
+  const otherInstanceId = ProviderInstanceId.make("codex-work");
+  const driver = ProviderDriverKind.make("codex");
+  const unavailable = {
+    checkedAt: "2026-10-14T11:05:28.387Z",
+    windows: [],
+    unavailable: {
+      reason: "unsupported" as const,
+      message: "ChatGPT tracks subscription usage across connected apps.",
+    },
+  };
+  const selected = {
+    id: "codex-personal",
+    driver,
+    label: "Evvi",
+    instanceId: selectedInstanceId,
+    limits: unavailable,
+  } satisfies UsageLimitsReport["accounts"][number];
+  const other = {
+    ...selected,
+    id: "codex-work",
+    label: "Work",
+    instanceId: otherInstanceId,
+  } satisfies UsageLimitsReport["accounts"][number];
+  const source = {
+    id: "proxy:codex-seat",
+    driver,
+    label: "CLI Proxy · Codex seat",
+    limits: {
+      checkedAt: unavailable.checkedAt,
+      windows: [
+        {
+          id: "weekly",
+          kind: "weekly" as const,
+          label: "Weekly",
+          usedPercent: 42,
+        },
+      ],
+    },
+  } satisfies UsageLimitsReport["accounts"][number];
+
+  it("keeps the selected native account and source accounts, excluding other instances", () => {
+    expect(selectComposerUsageAccounts([other, selected, source], selectedInstanceId)).toEqual([
+      selected,
+      source,
+    ]);
+    expect(selectComposerUsageAccounts([other, selected], null)).toEqual([]);
+  });
+
+  it("reports unavailable quota data without implying the authenticated account is unavailable", () => {
+    expect(composerQuotaSummary([selected])).toBe("Quota unavailable");
+    expect(composerQuotaSummary([source])).toBe("Weekly 42%");
+  });
+});
+
+const completed: CompletedUsageTurn = {
+  status: "completed",
+  startedAt: DateTime.makeUnsafe("2026-10-12T12:00:00Z"),
+  completedAt: DateTime.makeUnsafe("2026-10-12T12:00:10Z"),
+  turnTokenUsage: {
+    usageStatus: "complete",
+    usageScope: "main_agent",
+    inputTokens: 1000,
+    outputTokens: 200,
+    cachedInputTokens: 500,
+    hasSubagents: true,
+  },
+};
+
+describe("completedTurnDuration", () => {
+  it("retains timing without token usage", () => {
+    expect(completedTurnDuration({ ...completed, turnTokenUsage: undefined })).toBe(10000);
+    expect(
+      completedTurnDuration({
+        ...completed,
+        turnTokenUsage: {
+          usageStatus: "unavailable",
+          usageScope: "main_agent",
+          hasSubagents: false,
+        },
+      }),
+    ).toBe(10000);
+  });
+  it("rejects incomplete and reversed timing", () => {
+    expect(completedTurnDuration(null)).toBeNull();
+    expect(completedTurnDuration({ ...completed, status: "running" })).toBeNull();
+    expect(completedTurnDuration({ ...completed, startedAt: null })).toBeNull();
+    expect(
+      completedTurnDuration({
+        ...completed,
+        startedAt: completed.completedAt,
+        completedAt: completed.startedAt,
+      }),
+    ).toBeNull();
+  });
+});
+
+describe("lastResponseUsage", () => {
+  it("uses main-agent output over the full turn duration", () => {
+    expect(lastResponseUsage(completed)).toMatchObject({
+      inputTokens: 1000,
+      outputTokens: 200,
+      cachedInputTokens: 500,
+      tokensPerSecond: 20,
+      hasSubagents: true,
+      partial: false,
+    });
+  });
+  it("does not invent usage for missing reports or running turns", () => {
+    expect(lastResponseUsage(null)).toBeNull();
+    expect(lastResponseUsage({ ...completed, turnTokenUsage: undefined })).toBeNull();
+    expect(lastResponseUsage({ ...completed, status: "running" })).toBeNull();
+  });
+  it("omits speed for missing, zero or reversed durations", () => {
+    expect(lastResponseUsage({ ...completed, startedAt: null })?.tokensPerSecond).toBeNull();
+    expect(
+      lastResponseUsage({ ...completed, completedAt: completed.startedAt })?.tokensPerSecond,
+    ).toBeNull();
+    expect(
+      lastResponseUsage({
+        ...completed,
+        startedAt: completed.completedAt,
+        completedAt: completed.startedAt,
+      })?.tokensPerSecond,
+    ).toBeNull();
+  });
+  it("keeps partial counts visible without presenting partial usage as throughput", () => {
+    expect(
+      lastResponseUsage({
+        ...completed,
+        turnTokenUsage: {
+          usageStatus: "partial",
+          usageScope: "main_agent",
+          inputTokens: 10,
+          hasSubagents: false,
+        },
+      }),
+    ).toMatchObject({ inputTokens: 10, outputTokens: null, partial: true, tokensPerSecond: null });
+  });
+});
+
+describe("sessionUsage", () => {
+  it("sums completed main-agent turns without double counting reasoning or cache subsets", () => {
+    const turn = {
+      ...completed,
+      turnTokenUsage: {
+        ...completed.turnTokenUsage!,
+        cacheCreationTokens: 100,
+        reasoningTokens: 50,
+      },
+    };
+    expect(sessionUsage([turn, turn, { ...turn, status: "running" }])).toMatchObject({
+      turns: 2,
+      totalTokens: 2400,
+      inputTokens: 2000,
+      outputTokens: 400,
+      cachedInputTokens: 1000,
+      uncachedInputTokens: 1000,
+      cacheCreationTokens: 200,
+      cacheHitPercent: 50,
+      durationMs: 20000,
+      partial: false,
+    });
+  });
+  it("retains known totals but suppresses cache ratios when a turn is missing usage", () => {
+    expect(sessionUsage([completed, { ...completed, turnTokenUsage: undefined }])).toMatchObject({
+      turns: 2,
+      reportedTurns: 1,
+      totalTokens: 1200,
+      partial: true,
+      cacheHitPercent: null,
+      uncachedInputTokens: null,
+    });
+    expect(sessionUsage([])).toMatchObject({
+      totalTokens: null,
+      cacheHitPercent: null,
+      durationMs: null,
+    });
+  });
+  it("does not treat unreported cache counts as zero", () => {
+    expect(
+      sessionUsage([
+        {
+          ...completed,
+          turnTokenUsage: { ...completed.turnTokenUsage!, cachedInputTokens: undefined },
+        },
+      ]),
+    ).toMatchObject({ cachedInputTokens: null, uncachedInputTokens: null, cacheHitPercent: null });
+  });
+});
+
+describe("toolUsageDuration", () => {
+  const time = (seconds: number) => DateTime.makeUnsafe(seconds * 1000);
+  it("counts overlapping and nested tool intervals once", () => {
+    expect(
+      toolUsageDuration([
+        { startedAt: time(0), completedAt: time(10) },
+        { startedAt: time(2), completedAt: time(4) },
+        { startedAt: time(5), completedAt: time(15) },
+        { startedAt: time(20), completedAt: time(25) },
+      ]),
+    ).toBe(20000);
+  });
+  it("omits tool time when timestamps are missing or reversed", () => {
+    expect(toolUsageDuration([{ startedAt: null, completedAt: time(5) }])).toBeNull();
+    expect(toolUsageDuration([{ startedAt: time(5), completedAt: time(0) }])).toBeNull();
+    expect(toolUsageDuration([])).toBe(0);
+  });
+});
+
+it("formats compact session durations", () => {
+  expect(formatUsageDuration(245000)).toBe("4m 5s");
+  expect(formatUsageDuration(3660000)).toBe("1h 1m");
+  expect(formatUsageDuration(null)).toBe("—");
+});
diff --git a/apps/web/src/components/chat/composer-usage.logic.ts b/apps/web/src/components/chat/composer-usage.logic.ts
new file mode 100644
index 00000000..e48ea3ab
--- /dev/null
+++ b/apps/web/src/components/chat/composer-usage.logic.ts
@@ -0,0 +1,158 @@
+import type {
+  OrchestrationV2ProviderTurn,
+  ProviderInstanceId,
+  UsageLimitsReport,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+
+const compactCountFormatter = new Intl.NumberFormat("en-US", {
+  notation: "compact",
+  maximumSignificantDigits: 3,
+  maximumFractionDigits: 1,
+  roundingPriority: "lessPrecision",
+});
+
+export const compactTokenCount = (value: number | null | undefined) =>
+  value == null ? "—" : compactCountFormatter.format(value);
+
+export const selectComposerUsageAccounts = (
+  accounts: UsageLimitsReport["accounts"],
+  instanceId: ProviderInstanceId | null,
+): UsageLimitsReport["accounts"] =>
+  instanceId === null
+    ? []
+    : accounts.filter(
+        (account) => account.instanceId === instanceId || account.instanceId === undefined,
+      );
+
+export const composerQuotaSummary = (accounts: UsageLimitsReport["accounts"]) =>
+  accounts
+    .flatMap((account) =>
+      account.limits.windows.map((window) => `${window.label} ${window.usedPercent.toFixed(0)}%`),
+    )
+    .join(" · ") || "Quota unavailable";
+
+export type CompletedUsageTurn = Pick<
+  OrchestrationV2ProviderTurn,
+  "status" | "startedAt" | "completedAt" | "turnTokenUsage"
+>;
+
+export const completedTurnDuration = (turn: CompletedUsageTurn | null) => {
+  if (!turn || turn.status !== "completed" || !turn.startedAt || !turn.completedAt) return null;
+  const elapsedMs =
+    DateTime.toEpochMillis(turn.completedAt) - DateTime.toEpochMillis(turn.startedAt);
+  return elapsedMs >= 0 ? elapsedMs : null;
+};
+
+export const lastResponseUsage = (turn: CompletedUsageTurn | null) => {
+  const usage = turn?.turnTokenUsage;
+  if (!turn || turn.status !== "completed" || !usage || usage.usageStatus === "unavailable") {
+    return null;
+  }
+  const elapsedMs = completedTurnDuration(turn);
+  return {
+    durationMs: elapsedMs,
+    cacheCreationTokens: usage.cacheCreationTokens ?? null,
+    inputTokens: usage.inputTokens ?? null,
+    outputTokens: usage.outputTokens ?? null,
+    cachedInputTokens: usage.cachedInputTokens ?? null,
+    reasoningTokens: usage.reasoningTokens ?? null,
+    partial: usage.usageStatus === "partial",
+    hasSubagents: usage.hasSubagents,
+    tokensPerSecond:
+      usage.usageStatus === "complete" &&
+      usage.outputTokens !== undefined &&
+      elapsedMs !== null &&
+      elapsedMs > 0
+        ? (usage.outputTokens * 1000) / elapsedMs
+        : null,
+  };
+};
+
+export const formatUsageDuration = (milliseconds: number | null) => {
+  if (milliseconds === null) return "—";
+  const seconds = Math.round(milliseconds / 1000);
+  if (seconds < 60) return `${seconds}s`;
+  if (seconds < 3600) return `${Math.floor(seconds / 60)}m ${seconds % 60}s`;
+  return `${Math.floor(seconds / 3600)}h ${Math.floor((seconds % 3600) / 60)}m`;
+};
+
+export const sessionUsage = (turns: ReadonlyArray<CompletedUsageTurn>) => {
+  const completed = turns.filter((turn) => turn.status === "completed");
+  const reports = completed.map(lastResponseUsage).filter((usage) => usage !== null);
+  const sum = (
+    field: "inputTokens" | "outputTokens" | "cachedInputTokens" | "cacheCreationTokens",
+  ) => {
+    const values = reports.map((report) => report[field]).filter((value) => value !== null);
+    return values.length > 0 ? values.reduce((total, value) => total + value, 0) : null;
+  };
+  const inputTokens = sum("inputTokens");
+  const outputTokens = sum("outputTokens");
+  const cachedInputTokens = sum("cachedInputTokens");
+  const cacheCreationTokens = sum("cacheCreationTokens");
+  const completeCacheCoverage =
+    reports.length > 0 &&
+    reports.length === completed.length &&
+    reports.every(
+      (report) =>
+        !report.partial && report.inputTokens !== null && report.cachedInputTokens !== null,
+    );
+  const durations = completed.map(completedTurnDuration).filter((duration) => duration !== null);
+  return {
+    turns: completed.length,
+    reportedTurns: reports.length,
+    partial:
+      reports.length !== completed.length ||
+      reports.some(
+        (report) => report.partial || report.inputTokens === null || report.outputTokens === null,
+      ),
+    inputTokens,
+    outputTokens,
+    cachedInputTokens,
+    cacheCreationTokens,
+    uncachedInputTokens:
+      inputTokens !== null &&
+      cachedInputTokens !== null &&
+      completeCacheCoverage &&
+      inputTokens >= cachedInputTokens
+        ? inputTokens - cachedInputTokens
+        : null,
+    totalTokens: inputTokens !== null && outputTokens !== null ? inputTokens + outputTokens : null,
+    cacheHitPercent:
+      inputTokens !== null &&
+      inputTokens > 0 &&
+      cachedInputTokens !== null &&
+      completeCacheCoverage &&
+      cachedInputTokens <= inputTokens
+        ? (cachedInputTokens / inputTokens) * 100
+        : null,
+    durationMs:
+      durations.length === completed.length && durations.length > 0
+        ? durations.reduce((total, duration) => total + duration, 0)
+        : null,
+  };
+};
+
+export const toolUsageDuration = (
+  calls: ReadonlyArray<{
+    readonly startedAt: DateTime.Utc | null;
+    readonly completedAt: DateTime.Utc | null;
+  }>,
+) => {
+  const intervals: Array<{ start: number; end: number }> = [];
+  for (const call of calls) {
+    if (!call.startedAt || !call.completedAt) return null;
+    const start = DateTime.toEpochMillis(call.startedAt);
+    const end = DateTime.toEpochMillis(call.completedAt);
+    if (end < start) return null;
+    intervals.push({ start, end });
+  }
+  intervals.sort((left, right) => left.start - right.start);
+  let total = 0;
+  let previousEnd = Number.NEGATIVE_INFINITY;
+  for (const interval of intervals) {
+    total += Math.max(0, interval.end - Math.max(interval.start, previousEnd));
+    previousEnd = Math.max(previousEnd, interval.end);
+  }
+  return total;
+};
