{
  "name": "vtask",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types src/main.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "lint": "oxlint --deny-warnings src test scripts",
    "typecheck": "tsgo --noEmit",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt .",
    "schema:export": "node --experimental-strip-types scripts/export-task-schema.ts",
    "build": "bun src/build.ts",
    "release": "bun src/build.ts --release --all"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.1",
    "effect": "4.0.1",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.56.0",
    "oxlint": "1.56.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
