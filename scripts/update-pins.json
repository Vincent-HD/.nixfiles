      "description": "HumanLayer's selected Agent Skill source",
      "command": [
        "nix",
        "flake",
        "update",
        "humanlayer-skills"
      ]
    },
    {
      "name": "codex",
      "type": "nix-update",
      "description": "OpenAI Codex package tarball (CLI + code-mode host)",
      "systems": [
        "x86_64-linux"
      ],
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "codex",
        "--use-github-releases",
        "--github-releases-limit",
        "100",
        "--version-regex",
        "rust-v(.*)"
      ]
    },
    {
      "name": "opencodex",
      "type": "nix-update",
      "description": "OpenCodex npm release tarball, lockfile, and Bun dependency closure",
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "opencodex",
        "--use-update-script"
      ]
    },
    {
      "name": "executor",
      "type": "nix-update",
      "description": "Executor's current-platform npm binary",
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "executor",
        "--use-update-script"
      ]
    },
    {
      "name": "lightjj",
      "type": "nix-update",
      "description": "lightjj release tarball",
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "lightjj"
      ]
    },
    {
      "name": "arch-ops-server",
      "type": "nix-update",
