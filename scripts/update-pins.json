      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "jj-ryu",
        "--version=unstable"
      ]
    },
    {
      "name": "curseforge",
      "type": "nix-update",
      "description": "CurseForge AppImage version, build, and hash",
      "systems": [
        "x86_64-linux"
      ],
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "curseforge",
        "--use-update-script"
      ]
    },
    {
      "name": "cursor-agent",
      "type": "nix-update",
      "description": "Cursor Agent CLI current-platform release archive",
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "cursor-agent",
        "--use-update-script"
      ]
    },
    {
      "name": "plannotator",
      "type": "nix-update",
      "description": "Plannotator current-platform release binary and shared Agent Skills",
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "plannotator",
        "--use-update-script"
      ]
    },
    {
      "name": "moonshine",
      "type": "nix-update",
      "description": "Moonshine prebuilt Linux release archive",
      "systems": [
        "x86_64-linux"
      ],
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "moonshine"
      ]
    },
    {
      "name": "codex-desktop-linux",
      "type": "flake-input",
      "description": "ChatGPT/Codex Desktop Linux flake input",
      "command": [
        "nix",
        "flake",
        "update",
        "codex-desktop-linux"
      ]
    },
    {
      "name": "noctalia",
      "type": "flake-input",
      "description": "Intentionally held on the v4 Quickshell revision until a v5 migration",
      "command": [
        "nix",
        "flake",
        "update",
        "noctalia"
      ]
    },
    {
      "name": "iris",
      "type": "flake-input",
      "description": "IRIS terminal command suggestion tool flake input",
      "command": [
        "nix",
        "flake",
        "update",
        "iris"
      ]
    },
    {
      "name": "crosspipe",
      "type": "manual",
      "description": "Pinned to a specific Crosspipe commit; update only after manually choosing the target revision",
      "enabled": false,
      "command": [
        "nix-prefetch-git",
        "https://github.com/pinpox/Crosspipe.git",
        "--rev",
        "<rev>"
      ]
    },
    {
      "name": "cpuid-fault-emulation",
      "type": "manual",
      "description": "Vendored cpuid_fault_emulation source tree; replace only after auditing a manually downloaded update",
      "enabled": false,
      "command": [
        "nix",
        "shell",
        "nixpkgs#unzip",
        "-c",
        "unzip",
        "<verified-local-archive>",
        "-d",
        "packages/cpuid-fault-emulation/source"
      ]
    }
  ],
  "validations": {
    "fast": [
      {
        "name": "linux eval",
        "command": [
          "nix",
          "eval",
          ".#nixosConfigurations.pc-fixe.config.system.build.toplevel.drvPath",
          "--raw"
        ]
      },
      {
        "name": "darwin eval",
        "command": [
          "nix",
          "eval",
          ".#darwinConfigurations.macbook-pro.system",
          "--raw"
        ]
      },
      {
        "name": "curseforge build",
        "systems": [
          "x86_64-linux"
        ],
        "command": [
          "nix",
          "build",
          ".#curseforge",
          "--no-link"
        ]
      }
    ],
    "full": [
      {
        "name": "linux system build",
        "command": [
          "nix",
          "build",
          ".#nixosConfigurations.pc-fixe.config.system.build.toplevel",
          "--no-link"
        ]
      },
      {
        "name": "darwin system build",
        "command": [
          "nix",
          "build",
          ".#darwinConfigurations.macbook-pro.system",
          "--no-link"
        ]
      }
    ]
  }
}
