      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "arch-ops-server",
        "--use-update-script"
      ]
    },
    {
      "name": "papercuts",
      "type": "nix-update",
      "description": "Papercuts tagged source compiled with Bun",
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "papercuts",
        "--use-github-releases"
      ]
    },
    {
      "name": "portless",
      "type": "nix-update",
      "description": "Portless npm release tarball",
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "portless",
        "--use-update-script"
      ]
    },
    {
      "name": "jj-ryu",
      "type": "nix-update",
