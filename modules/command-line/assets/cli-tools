  fi

if [[ "$show_commands" -eq 1 ]]; then
  printf '\n%b%s%b\n' "$DIM" "Available: $available_count command(s)" "$RESET"
  if [[ "$show_all" -eq 1 ]]; then
    printf '%bMissing from PATH: %s command(s)%b\n' "$DIM" "$missing_count" "$RESET"
  fi
fi
printf '%bTip: run cli-tools --all to audit entries on another host.%b\n' "$DIM" "$RESET"
