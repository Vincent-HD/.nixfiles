#!/usr/bin/env bash

# Print a quick, human-friendly inventory of the Nix-managed terminal toolkit.
# The catalog is intentionally kept here instead of embedded in a Nix module so
# it can be extended without changing shell-generation logic.

set -u

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  RESET=$'\033[0m'
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  RED=$'\033[31m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  BLUE=$'\033[34m'
  CYAN=$'\033[36m'
else
  RESET=''
  BOLD=''
  DIM=''
  RED=''
  GREEN=''
  YELLOW=''
  BLUE=''
  CYAN=''
fi

show_all=0
show_aliases=1
show_commands=1

for argument in "$@"; do
  case "$argument" in
    --all)
      show_all=1
      ;;
    --commands-only)
      show_aliases=0
      ;;
    --aliases-only)
      show_aliases=1
      show_commands=0
      ;;
    -h|--help)
      cat <<'USAGE'
Usage: cli-tools [OPTION]

Print the available Nix-managed terminal tools, their purpose, and a quick example.

Options:
  --all              Include catalog entries that are not available on this host.
  --commands-only    Hide the shell aliases and helper functions section.
  --aliases-only     Print only aliases and helper functions.
  -h, --help         Show this help.

Set NO_COLOR=1 to disable ANSI colors.
USAGE
      exit 0
      ;;
    *)
      printf '%bUnknown option:%b %s\n' "$RED" "$RESET" "$argument" >&2
      printf 'Try %scli-tools --help%s.\n' "$CYAN" "$RESET" >&2
      exit 2
      ;;
  esac
done

print_heading() {
  printf '\n%b%s%b\n' "$BLUE$BOLD" "$1" "$RESET"
}

print_command() {
  local category="$1"
  local command_name="$2"
  local description="$3"
  local example="$4"
  local command_path

  command_path="$(command -v "$command_name" 2>/dev/null || true)"
  if [[ -n "$command_path" ]]; then
    printf '  %b✓%b %b%-18s%b %s\n' "$GREEN" "$RESET" "$BOLD" "$command_name" "$RESET" "$description"
    printf '      %bExample:%b %s\n' "$DIM" "$RESET" "$example"
    available_count=$((available_count + 1))
  elif [[ "$show_all" -eq 1 ]]; then
    printf '  %b-%b %b%-18s%b %s\n' "$YELLOW" "$RESET" "$DIM" "$command_name" "$RESET" "$description"
    printf '      %bExample:%b %s\n' "$DIM" "$RESET" "$example"
    missing_count=$((missing_count + 1))
  fi
}

available_count=0
missing_count=0
current_category=''

if [[ "$show_aliases" -eq 1 ]]; then
  print_heading 'Shell aliases and helper functions'
  cat <<'ALIASES'
  cat       -> bat                         Read files with syntax highlighting.
  cd        -> z                           Jump to a frequently used directory.
  cdg       -> zi                          Interactively choose a directory with zoxide.
  df        -> duf                         Show filesystem usage in a readable table.
  du        -> dua                         Explore disk usage interactively.
  find      -> fd                          Find files with a fast, friendly interface.
  grep      -> rg                          Search text recursively with ripgrep.
  help      -> tldr                        Show concise command examples.
  la        -> eza --all --long --git      List all files with details and Git state.
  ll        -> eza --long --git            List files with details and Git state.
  ls        -> eza --icons=auto            List files with icons.
  lt        -> eza --tree --level=2        Show a two-level directory tree.
  ping      -> gping                       Ping a host with a live terminal graph.
  pkill     -> pik                         Interactively choose a process to terminate.
  ps        -> procs                       Show processes in a readable table.
  top       -> btop                        Monitor CPU, memory, disks, and processes.
  tree      -> eza --tree                  Show a directory tree.
  y         -> yazi                         Open the terminal file manager.
  md        -> glow / bat                  View Markdown in a terminal, with a pipe-safe fallback.
  img       -> catimg / cat                View images in a terminal, with a pipe-safe fallback.
  view      -> glow / catimg / bat         Pick a viewer based on the file type.
ALIASES
fi

if [[ "$show_commands" -eq 1 ]]; then
  print_heading 'Available commands'
fi

if [[ "$show_commands" -eq 1 ]]; then
  while IFS='|' read -r category command_name description example; do
    [[ -z "$category" || "$category" == \#* ]] && continue
    if [[ "$category" != "$current_category" ]]; then
      print_heading "$category"
      current_category="$category"
    fi
    print_command "$category" "$command_name" "$description" "$example"
  done <<'CATALOG'
Navigation & files|bat|Read files with syntax highlighting and paging|bat README.md
Navigation & files|eza|List files with icons, Git state, or a directory tree|eza --tree --level=2
Navigation & files|fd|Find files and directories with a simple fast syntax|fd '\\.nix$' modules
Navigation & files|fzf|Interactively filter files, history, or any piped list|rg --files | fzf
Navigation & files|glow|Render Markdown beautifully in the terminal|glow README.md
Navigation & files|rg|Search text recursively with smart defaults (ripgrep)|rg 'TODO' modules
Navigation & files|sd|Replace text in files using a friendlier sed syntax|sd 'old-name' 'new-name' file.txt
Navigation & files|yazi|Browse and manage files in a terminal file manager|yazi .
Navigation & files|zoxide|Jump to directories by frecency from the z/zi helpers|zoxide query nixfiles
