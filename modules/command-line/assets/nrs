#!/usr/bin/env bash

# Switch this machine from the nixfiles flake, or update its pins through update-pins.
# Plain `nrs` keeps the pinned inputs.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  nrs [--tokitoki [path]] [nh options]   Switch this machine with the pinned inputs.
  nrs update [--switch] [update-pins options]
                                         Update every flake input and pinned package
                                         (`nix run .#update-pins`); --switch rebuilds
                                         afterwards when every update succeeded.
  nrs update --help                      List the update-pins options (--only, --skip,
                                         --check, --list, --dry-run, --validate, ...).

The flake is the local directory named by NH_FLAKE (default: ~/.nixfiles).

Tokitoki:
  --tokitoki [path]   Use a local checkout instead of the pinned input.
                      Default path: ~/lab/tokitoki.

Other arguments are passed to nh, for example --dry or --ask.
EOF
}

fail() {
  printf 'nrs: %s\n' "$1" >&2
  exit 2
}

flake_root() {
  local flake_ref="${NH_FLAKE:-$HOME/.nixfiles}"
  case "$flake_ref" in
    path:*) flake_ref="${flake_ref#path:}" ;;
    *://* | github:* | git+* | flake:*) fail "NH_FLAKE must name a local flake directory for nrs update" ;;
  esac
  [[ "$flake_ref" != *\?* && "$flake_ref" != *\#* ]] || fail "NH_FLAKE must be a plain local directory path"
  [[ -d "$flake_ref" ]] || fail "flake directory not found: $flake_ref"
  (cd "$flake_ref" && pwd -P) || fail "cannot resolve flake directory: $flake_ref"
}

switch_system() {
  if [[ "$(uname -s)" == Darwin ]]; then
    exec nh darwin switch "$@"
  fi
  exec nh os switch "$@"
}

run_update() {
  local switch_after=0
  local dry_run=0
  local -a update_pins_args=()
  local argument
  for argument in "$@"; do
    case "$argument" in
      --switch) switch_after=1 ;;
      --dry-run)
        dry_run=1
        update_pins_args+=("$argument")
        ;;
      *) update_pins_args+=("$argument") ;;
    esac
  done

  local root
  root="$(flake_root)"
  printf 'nrs: update-pins in %s\n' "$root"
  UPDATE_PINS_REPO_ROOT="$root" nix run --no-write-lock-file "$root#update-pins" -- "${update_pins_args[@]}"

  if [[ "$switch_after" == 1 && "$dry_run" == 0 ]]; then
    switch_system
  fi
}

if [[ "${1:-}" == update ]]; then
  shift
  run_update "$@"
  exit 0
fi

tokitoki=""
nh_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    # nh has its own --update flag, so stop the old nrs spelling before it reaches nh.
    --update | --list-updates | --inputs | --pins)
      fail "$1 was replaced by 'nrs update [update-pins options]'; see 'nrs update --help'"
      ;;
    --tokitoki)
      shift
      tokitoki="$HOME/lab/tokitoki"
      if [[ $# -gt 0 && "$1" != -* ]]; then
        tokitoki="$1"
        shift
      fi
      ;;
    --)
      shift
      nh_args+=("$@")
      break
      ;;
    *)
      nh_args+=("$1")
      shift
      ;;
  esac
done

if [[ -n "$tokitoki" ]]; then
  [[ -e "$tokitoki" ]] || fail "Tokitoki checkout not found: $tokitoki"
  printf 'nrs: tokitoki %s\n' "$tokitoki"
  nh_args+=(--override-input tokitoki "path:$tokitoki")
fi

switch_system "${nh_args[@]}"
