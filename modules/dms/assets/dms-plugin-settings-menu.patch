+    function pluginSettingsPath(widgetId) {
+        const rawId = String(widgetId || "");
+        const pluginId = rawId.split(":")[0];
+        const plugins = PluginService.availablePlugins;
+        const plugin = plugins ? plugins[pluginId] : null;
+        if (!plugin || !plugin.settingsPath)
+            return "";
+        const path = String(plugin.settingsPath);
+        return path.startsWith("file://") ? path : "file://" + path;
+    }
